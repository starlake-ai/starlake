# Copy to `.env`, fill in, never commit `.env`.

# ----- Release announcements (maintainers only) -----
#
# Discord webhook for the #news channel. scripts/local-release.sh's step 10
# calls scripts/announce-release-discord.sh after publishing the GitHub
# release; it posts the repo link plus the version's CHANGELOG.md section.
# The webhook URL is a credential - keep it in the untracked .env, never here.
#SL_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
